# Copia este archivo a .env (el .env NO se sube a Git)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campuslands_ops
DB_USER=root
DB_PASSWORD=

# OpenAI (gpt-4o-mini). Si se deja vacía, triaje/recomendación/copiloto usan motor de reglas local.
AI_API_KEY=tu_api_key_openai_aqui

# Secreto local para firmar JWT (cámbialo en tu máquina; no uses el valor de ejemplo en producción)
JWT_SECRET=campuslands-ops-local-dev-only-change-me
